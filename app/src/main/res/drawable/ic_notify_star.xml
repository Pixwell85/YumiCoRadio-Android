<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: the star from the Yumi Co. Radio wordmark.

     Android tints a small icon a single colour and discards everything but its alpha, so this has
     to be a solid silhouette — a colour or a stroke here would come out as a white blob. Drawn on
     the 24dp notification canvas rather than reusing the 108dp launcher layer, whose star sits
     inside a launcher safe zone and would render small and lost in the status bar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.5 L14.47,8.6 L21.99,8.76 L15.99,13.3 L18.17,20.49 L12,16.2 L5.83,20.49 L8.01,13.3 L2.01,8.76 L9.53,8.6 Z" />
</vector>
